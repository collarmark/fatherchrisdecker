---
layout: base.njk
---
{% block content %}

<div id="protected-gate">
  <section class="page-hero">
    <div class="container">
      <h1>{{ title }}</h1>
    </div>
  </section>
  <section class="section">
    <div class="container" style="max-width: 400px;">
      <form id="gate-form">
        <label for="gate-password" style="display:block; font-family: var(--font-heading); font-size: .85rem; color: var(--text-muted); margin-bottom: .5rem;">Password required</label>
        <input type="password" id="gate-password" placeholder="Enter password" autocomplete="current-password"
          style="width: 100%; padding: .6rem .9rem; font-size: 1rem; border: 1px solid var(--blue-mid); border-radius: var(--radius); margin-bottom: .75rem; box-sizing: border-box;" />
        <button type="submit" class="btn btn--gold" style="width: 100%;">Enter</button>
        <p id="gate-error" style="color: #c0392b; margin-top: .6rem; font-size: .875rem; display: none;">Incorrect password.</p>
      </form>
    </div>
  </section>
</div>

<div id="protected-content" hidden>
  <div class="docs-layout">

    <aside class="docs-sidebar" aria-label="Document sections">
      <div class="docs-sidebar__title">{{ title }}</div>
      <nav class="docs-nav" id="docs-nav" aria-label="Sections"></nav>
    </aside>

    <div class="docs-content" id="docs-content">
      {{ content | safe }}
    </div>

  </div>
</div>

<script>
  (function () {
    var PASSWORD = 'Leadmeguidem3';
    var STORAGE_KEY = 'unlocked_{{ page.url | replace("/", "_") }}';

    function buildNav() {
      var content = document.getElementById('docs-content');
      var nav     = document.getElementById('docs-nav');
      if (!content || !nav) return;

      var headings = content.querySelectorAll('h2');
      if (!headings.length) return;

      headings.forEach(function (h, i) {
        if (!h.id) {
          h.id = 'sec-' + h.textContent.trim()
            .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
        }
        var a = document.createElement('a');
        a.href  = '#' + h.id;
        a.className = 'docs-nav__link';
        a.textContent = h.textContent;
        a.addEventListener('click', function (e) {
          e.preventDefault();
          document.getElementById(h.id)
            .scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', '#' + h.id);
        });
        nav.appendChild(a);
      });

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          nav.querySelectorAll('.docs-nav__link--active')
             .forEach(function (l) { l.classList.remove('docs-nav__link--active'); });
          var link = nav.querySelector('a[href="#' + entry.target.id + '"]');
          if (link) link.classList.add('docs-nav__link--active');
        });
      }, { rootMargin: '-8% 0px -82% 0px' });

      headings.forEach(function (h) { observer.observe(h); });
    }

    function unlock() {
      document.getElementById('protected-gate').hidden = true;
      document.getElementById('protected-content').hidden = false;
      buildNav();
    }

    if (sessionStorage.getItem(STORAGE_KEY) === '1') { unlock(); return; }

    document.getElementById('gate-form').addEventListener('submit', function (e) {
      e.preventDefault();
      if (document.getElementById('gate-password').value === PASSWORD) {
        sessionStorage.setItem(STORAGE_KEY, '1');
        unlock();
      } else {
        document.getElementById('gate-error').style.display = 'block';
        document.getElementById('gate-password').value = '';
        document.getElementById('gate-password').focus();
      }
    });
  })();
</script>

{% endblock %}
