---
layout: base.njk
title: Frequently Asked Faith
permalink: /frequently-asked-faith/
---

<section class="page-hero">
  <div class="container">
    <h1>Frequently Asked Faith</h1>
    <p>My most common theological and catechetical questions &mdash; a living notebook for the curious and the faithful.</p>
  </div>
</section>

<section class="section">
  <div class="container">

    <div class="filter-bar" role="group" aria-label="Filter by category">
      <button class="filter-btn filter-btn--active" data-filter="all">All</button>
      <button class="filter-btn" data-filter="Apologetics">Apologetics</button>
      <button class="filter-btn" data-filter="Church Teaching">Church Teaching</button>
      <button class="filter-btn" data-filter="History">History</button>
      <button class="filter-btn" data-filter="Liturgy">Liturgy</button>
      <button class="filter-btn" data-filter="Morality">Morality</button>
      <button class="filter-btn" data-filter="Prayer">Prayer</button>
      <button class="filter-btn" data-filter="Sacraments">Sacraments</button>
      <button class="filter-btn" data-filter="Scripture">Scripture</button>
      <button class="filter-btn" data-filter="Saints">Saints</button>
      <button class="filter-btn" data-filter="Theology">Theology</button>
    </div>

    <div class="card-grid" id="faf-grid">
      {% for entry in collections.faf %}
      <article class="card faf-card" data-category="{{ entry.data.category }}">
        <a class="card__img-link{% if not entry.data.coverImage %} faf-card__placeholder{% endif %}" href="{{ entry.url }}" tabindex="-1" aria-hidden="true">
          {% if entry.data.coverImage %}
          <img src="{{ entry.data.coverImage }}" alt="" loading="lazy"{% if entry.data.coverImagePosition %} style="object-position: {{ entry.data.coverImagePosition }}"{% endif %} />
          {% endif %}
        </a>
        <div class="card__body">
          {% if entry.data.category %}
          <div class="card__meta">
            <span class="tag tag--{{ entry.data.category | lower | replace(' ', '-') }}">{{ entry.data.category }}</span>
          </div>
          {% endif %}
          <h2 class="card__title faf-card__question">
            <a href="{{ entry.url }}">{{ entry.data.title }}</a>
          </h2>
          {% if entry.data.excerpt %}
          <p class="card__excerpt">{{ entry.data.excerpt }}</p>
          {% endif %}
        </div>
      </article>
      {% else %}
      <p style="color: var(--text-muted); font-style: italic;">No entries yet. Check back soon.</p>
      {% endfor %}
    </div>

  </div>
</section>

{% block scripts %}
<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const fafCards   = document.querySelectorAll('#faf-grid .faf-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('filter-btn--active'));
      btn.classList.add('filter-btn--active');
      const filter = btn.dataset.filter;
      fafCards.forEach(card => {
        card.style.display = (filter === 'all' || card.dataset.category === filter) ? '' : 'none';
      });
    });
  });
</script>
{% endblock %}
